API_HOST=0.0.0.0
API_PORT=8080
DATABASE_MAX_CONNECTIONS=10
DATABASE_SCHEMA_VERSION=3
AUTH_SIGNING_KEY=replace-with-a-random-signing-key-at-least-32-bytes
AUTH_ISSUER=face-search-api
AUTH_AUDIENCE=face-search-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
QDRANT_COLLECTION=face-search-faces
FACE_AI_INTERNAL_TOKEN=
# NON-PRODUCTION test threshold only. Not a validated production value; the
# production face-search threshold is gated on the Checkpoint 1 benchmark.
SEARCH_NON_PRODUCTION_THRESHOLD=0.5
SEARCH_RESULT_LIMIT=100
REDIS_STREAM=photo-jobs
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_TTL=30s
