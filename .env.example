# Local development placeholders only. Copy this file to ignored `.env` and
# replace passwords before starting Compose. Never reuse these values elsewhere.
APP_PORT=8088
API_PORT=8080
PUBLIC_API_URL=http://localhost:8080

POSTGRES_USER=face_search
POSTGRES_PASSWORD=change-me
POSTGRES_DB=face_search
DATABASE_MAX_CONNECTIONS=10
DATABASE_SCHEMA_VERSION=3

# Replace with at least 32 random bytes in ignored `.env`.
AUTH_SIGNING_KEY=replace-with-a-random-signing-key-at-least-32-bytes
AUTH_ISSUER=face-search-api
AUTH_AUDIENCE=face-search-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000

MINIO_ROOT_USER=face-search-admin
MINIO_ROOT_PASSWORD=change-me-now
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=face-search
PHOTO_MAX_BYTE_SIZE=104857600
PHOTO_UPLOAD_PART_SIZE=8388608
PHOTO_UPLOAD_MAX_PARTS=1000
PHOTO_UPLOAD_SIGN_TTL=10m
PHOTO_UPLOAD_SESSION_TTL=24h

# Controlled customer downloads. Signed GET links are short-lived, scoped to one
# stored object, and cannot be replayed for another object, Event, or tenant.
DOWNLOAD_URL_TTL=2m
DOWNLOAD_MAX_BULK=50
DOWNLOAD_RATE_LIMIT=30
DOWNLOAD_RATE_WINDOW=1m

# Abuse controls. Auth (register/login/refresh) is rate limited per client address;
# public selfie search is rate limited per public token and client address.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
SEARCH_RATE_LIMIT=15
SEARCH_RATE_WINDOW=1m

# HTTP server and per-request timeouts. HTTP_REQUEST_TIMEOUT returns a safe timeout
# response; server write timeout is set above it so the handler can respond first.
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=30s

REDIS_STREAM=photo-jobs
REDIS_GROUP=photo-workers
DEAD_LETTER_STREAM=photo-jobs-dlq
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_TTL=30s

# Observability. Service /metrics endpoints (API :8080, Face AI :8001, and the
# worker health/metrics surface) are internal to the Docker network and are never
# routed through the public reverse proxy. Prometheus scrapes them and is bound to
# loopback only for local operator access. See docs/runbooks.md.
WORKER_HEALTH_PORT=9100
PROMETHEUS_PORT=9090

# Data retention windows in whole days, enforced by scripts/retention-prune.sh.
# Selfie bytes and embeddings are never persisted (nothing to prune). Audit and
# download records are retained longest for compliance; ephemeral search-session
# rows are retained briefly. Never shorten AUDIT below your compliance obligation.
SEARCH_RETENTION_DAYS=90
DOWNLOAD_RECORD_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
UPLOAD_SESSION_RETENTION_DAYS=7
OUTBOX_RETENTION_DAYS=7

# Backup and restore (scripts/backup/*). Env-driven with pinned tool images; no
# secrets are stored in the scripts. BACKUP_ROOT holds artifacts (keep it ignored
# and off-host); BACKUP_NETWORK is the running stack's Docker network. See
# docs/backup-restore.md.
BACKUP_ROOT=./backups
# BACKUP_NETWORK=face-search-ai_app
QDRANT_COLLECTION=face-search-faces

# CPU runtime only. Model files must remain outside this repository.
FACE_AI_MODELS_REQUIRED=false
FACE_AI_ONNX_PROVIDER=CPUExecutionProvider

# Personal, local, non-commercial PoC only. Point this at an external root
# containing models/buffalo_l; the service will not download the pack.
FACE_AI_INSIGHTFACE_ENABLED=false
FACE_AI_INSIGHTFACE_MODEL_ROOT=/absolute/path/outside/repository/insightface
FACE_AI_INSIGHTFACE_PACK=buffalo_l
FACE_AI_INSIGHTFACE_DETECTION_WIDTH=640
FACE_AI_INSIGHTFACE_DETECTION_HEIGHT=640
FACE_AI_INSIGHTFACE_DETECTION_THRESHOLD=0.5

# Shared secret for the internal inference endpoint. When empty, the endpoint
# is reachable only inside the private Docker network. Set a random value to
# require the X-Internal-Token header from internal callers.
FACE_AI_INTERNAL_TOKEN=
