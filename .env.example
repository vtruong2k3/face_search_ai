# Local development placeholders only. Copy this file to ignored `.env` and
# replace passwords before starting Compose. Never reuse these values elsewhere.
APP_PORT=8088
API_PORT=8080
PUBLIC_API_URL=http://localhost:8080

POSTGRES_USER=face_search
POSTGRES_PASSWORD=change-me
POSTGRES_DB=face_search

MINIO_ROOT_USER=face-search-admin
MINIO_ROOT_PASSWORD=change-me-now
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=face-search

REDIS_STREAM=photo-jobs
REDIS_GROUP=photo-workers
DEAD_LETTER_STREAM=photo-jobs-dlq

# CPU runtime only. Model files must remain outside this repository.
FACE_AI_MODELS_REQUIRED=false
FACE_AI_ONNX_PROVIDER=CPUExecutionProvider

# Personal, local, non-commercial PoC only. Point this at an external root
# containing models/buffalo_l; the service will not download the pack.
FACE_AI_INSIGHTFACE_ENABLED=false
FACE_AI_INSIGHTFACE_MODEL_ROOT=/absolute/path/outside/repository/insightface
FACE_AI_INSIGHTFACE_PACK=buffalo_l
FACE_AI_INSIGHTFACE_DETECTION_WIDTH=640
FACE_AI_INSIGHTFACE_DETECTION_HEIGHT=640
FACE_AI_INSIGHTFACE_DETECTION_THRESHOLD=0.5
